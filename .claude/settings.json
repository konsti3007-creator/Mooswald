{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.agent-support/route.cjs"
            ],
            "timeout": 5,
            "onFailure": "continue"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.agent-support/route.cjs"
            ],
            "timeout": 5,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
